FROM mambaorg/micromamba:1.4.7

USER root
# Keep the base environment activated
ARG MAMBA_DOCKERFILE_ACTIVATE=1
ENV MAMBA_REMOTE_CONNECT_TIMEOUT_SECS=60 \
    MAMBA_REMOTE_READ_TIMEOUT_SECS=600 \
    MAMBA_REMOTE_MAX_RETRIES=5 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update -o Acquire::Retries=5 && \
    apt-get install -y --fix-missing -o Acquire::Retries=5 git gcc g++ make

# Use micromamba to resolve conda-forge, much faster than conda
RUN micromamba install -y python=3.8.17 pip=20.0.2 rdkit=2020.09.5 -c conda-forge
RUN pip install --index-url https://pypi.org/simple --prefer-binary --retries 10 --timeout 120 \
    fastapi==0.95.1 \
    pillow==10.1.0 \
    protobuf==3.19.0 \
    pydantic==1.10.12 \
    rdchiral==1.1.0 \
    requests==2.31.0 \
    scikit-learn==1.0.2 \
    scipy==1.7.3 \
    tensorflow-cpu==2.7.4 \
    urllib3==1.26.16 \
    uvicorn==0.21.1 \
    zipp==3.20.2

COPY . /app/scscore
WORKDIR /app/scscore

EXPOSE 9741

ENV CUDA_VISIBLE_DEVICES=10

CMD ["python", "scscore_server.py"]
