FROM mambaorg/micromamba:2.3.1-debian12-slim

USER root
# Keep the base environment activated
ARG MAMBA_DOCKERFILE_ACTIVATE=1
ENV MAMBA_REMOTE_CONNECT_TIMEOUT_SECS=60 \
    MAMBA_REMOTE_READ_TIMEOUT_SECS=600 \
    MAMBA_REMOTE_MAX_RETRIES=5 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update -o Acquire::Retries=5 && \
    apt-get install -y --fix-missing -o Acquire::Retries=5 git gcc g++ make

RUN micromamba install -y python=3.9.22 pip=25.2 rdkit=2020.09.5 -c conda-forge
RUN pip install --index-url https://pypi.org/simple --prefer-binary --retries 10 --timeout 120 \
    fastapi==0.116.1 \
    pillow==11.3.0 \
    prometheus-client==0.22.1 \
    protobuf==3.19.0 \
    pydantic==2.11.7 \
    rdchiral==1.1.0 \
    requests==2.32.5 \
    scikit-learn==1.6.1 \
    scipy==1.13.1 \
    tensorflow-cpu==2.7.4 \
    urllib3==2.5.0 \
    uvicorn==0.35.0 \
    zipp==3.23.0

COPY . /app/fast_filter
WORKDIR /app/fast_filter

EXPOSE 9611

ENV CUDA_VISIBLE_DEVICES=10

CMD ["python", "fast_filter_server.py"]
