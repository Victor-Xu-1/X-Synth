Bootstrap: docker
From: tensorflow/tensorflow:2.7.4-gpu

%files
    . /app/fast_filter

%post
    pip install \
        fastapi==0.95.1 \
        rdkit-pypi==2020.09.5.2 \
        protobuf==3.19.0 \
        scipy \
        uvicorn==0.21.1

%runscript
    cd /app/fast_filter
    python fast_filter_server.py
