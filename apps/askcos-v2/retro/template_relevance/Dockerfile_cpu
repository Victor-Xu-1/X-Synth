FROM mambaorg/micromamba:1.4.7

USER root
# Keep the base environment activated
ARG MAMBA_DOCKERFILE_ACTIVATE=1
RUN apt-get update -o Acquire::Retries=5 && \
    (apt-get install -y --fix-missing -o Acquire::Retries=5 git gcc g++ make || \
     (apt-get update -o Acquire::Retries=5 && apt-get install -y --fix-missing -o Acquire::Retries=5 git gcc g++ make))

# Use micromamba to resolve conda-forge, much faster than conda
ENV MAMBA_REMOTE_CONNECT_TIMEOUT_SECS=60 \
    MAMBA_REMOTE_READ_TIMEOUT_SECS=600 \
    MAMBA_REMOTE_MAX_RETRIES=5 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN micromamba config append channels conda-forge && \
    micromamba config append channels pytorch && \
    micromamba config set channel_priority strict
RUN micromamba install -y \
    python=3.8.17 \
    pip=23.2.1 \
    rdkit=2020.09.5 \
    openjdk=11.0.15 \
    pytorch==1.12.1 \
    cpuonly \
    "mkl>=2022.1,<2023" \
    rdchiral_cpp=1.1.2
RUN pip install --index-url https://pypi.org/simple --prefer-binary --retries 10 --timeout 120 \
    fastapi==0.95.1 \
    hdbscan==0.8.33 \
    networkx==2.5.1 \
    opennmt-py==1.2.0 \
    pandas==1.5.3 \
    pebble==5.0.3 \
    pillow==10.1.0 \
    protobuf==3.19.0 \
    pydantic==1.10.12 \
    requests==2.31.0 \
    rxnmapper==0.3.0 \
    scikit-learn==1.0.2 \
    scipy==1.7.3 \
    torch-model-archiver==0.3.1 \
    torchserve==0.3.1 \
    tqdm==4.66.1 \
    urllib3==1.26.16 \
    uvicorn==0.21.1

COPY . /app/template_relevance
WORKDIR /app/template_relevance

ENV CUDA_VISIBLE_DEVICES=10

EXPOSE 9410 9411 9412
