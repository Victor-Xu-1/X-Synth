Bootstrap: docker
From: continuumio/miniconda3:22.11.1

%files
    . /app/site_selectivity

%environment
    export CUDA_VISIBLE_DEVICES=10

%post
    conda install -y mamba -c conda-forge
    mamba install -y -q python=3.7 pip rdkit=2020.09.5 -c conda-forge
    pip install \
        fastapi==0.95.1 \
        protobuf==3.19.0 \
        scipy \
        tensorflow-cpu==2.7 \
        uvicorn==0.21.1

%runscript
    cd /app/site_selectivity
    python site_selectivity_server.py
