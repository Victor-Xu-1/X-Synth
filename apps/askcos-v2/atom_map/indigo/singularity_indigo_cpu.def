Bootstrap: docker
From: continuumio/miniconda3:23.3.1-0

%environment
    export CUDA_VISIBLE_DEVICES=10

%post
    conda install -y mamba=1.4.7 -c conda-forge
    mamba install -y -q python=3.8 pip -c conda-forge
    pip install \
        fastapi==0.95.1 \
        epam.indigo==1.4.3 \
        uvicorn==0.21.1
