FROM mambaorg/micromamba:1.4.7

USER root
# Keep the base environment activated
ARG MAMBA_DOCKERFILE_ACTIVATE=1
ENV MAMBA_REMOTE_CONNECT_TIMEOUT_SECS=60 \
    MAMBA_REMOTE_READ_TIMEOUT_SECS=600 \
    MAMBA_REMOTE_MAX_RETRIES=5 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update -o Acquire::Retries=5 && \
    apt-get install -y --no-install-recommends -o Acquire::Retries=5 git gcc g++ make

# Use micromamba to resolve conda-forge, much faster than conda
# rdchiral_cpp 1.1.2 has no Python 3.8 build compatible with RDKit 2022.09.5
# on current conda-forge metadata; 2021.09.5 is the newest solvable set.
RUN micromamba install -y python=3.8.17 pip=23.2.1 rdkit=2021.09.5 rdchiral_cpp=1.1.2 -c conda-forge
RUN pip install --index-url https://pypi.org/simple --prefer-binary --retries 10 --timeout 120 \
    fastapi==0.95.1 \
    pillow==10.1.0 \
    protobuf==3.19.0 \
    pydantic==1.10.12 \
    pytest==7.4.1 \
    requests==2.31.0 \
    scipy==1.7.3 \
    tqdm==4.66.1 \
    uvicorn==0.21.1

COPY . /app/expand_one
WORKDIR /app/expand_one

EXPOSE 9301

ENV CUDA_VISIBLE_DEVICES=10

CMD ["python", "expand_one_server.py"]
