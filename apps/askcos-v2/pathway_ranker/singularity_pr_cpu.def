Bootstrap: docker
From: continuumio/miniconda3:23.3.1-0

%environment
    export CUDA_VISIBLE_DEVICES=10

%post
    apt update && apt -y install gcc g++ make
    conda install -y mamba=1.4.7 -c conda-forge
    mamba install -y -q python=3.8 pip=20.0.2 rdkit=2020.09.5 -c conda-forge
    mamba install -y -q pytorch==1.12.1 cpuonly -c pytorch -c conda-forge
    pip install \
        fastapi==0.95.1 \
        hdbscan==0.8.33 \
        protobuf==3.19.0 \
        pydantic==1.10.12 \
        scikit-learn==1.0.2 \
        scipy==1.7.3 \
        urllib3==1.26.16 \
        uvicorn==0.21.1
