# Product configuration only. Credentials belong in an owner-only external file.
X_SYNTH_AUTH_MODE=local
X_SYNTH_ALLOWED_ORIGINS=http://127.0.0.1:8769,http://localhost:8769
X_SYNTH_STATE_DIR=/absolute/private/x-synth/state
X_SYNTH_STOCK_INDEX=/absolute/x-synth/assets/stock/catalog.sqlite
X_SYNTH_TEMPLATE_LIBRARY_DB=/absolute/x-synth/assets/knowledge/template_library.sqlite
X_SYNTH_ASKCOS_URL=http://127.0.0.1:9100
X_SYNTH_ASKCOS_MODELS=pistachio,pistachio_ringbreaker
X_SYNTH_CONDITION_URL=http://127.0.0.1:9901
X_SYNTH_FORWARD_URL=http://127.0.0.1:9911
X_SYNTH_IMPURITY_URL=http://127.0.0.1:9941
# serve_platform defaults this to the optimization-env under its configured assets.
X_SYNTH_OPTIMIZATION_PYTHON=/absolute/x-synth/assets/optimization-env/bin/python

# v0.1.0 supports one product job and one execution per model service.
X_SYNTH_ACTIVE_JOBS=1
X_SYNTH_QUEUED_JOBS=64
X_SYNTH_SEARCH_PARALLELISM=2
X_SYNTH_MODEL_THREADS=4
X_SYNTH_MODEL_PARALLELISM=1
X_SYNTH_REVIEW_PARALLELISM=1
X_SYNTH_STOCK_BATCH_SIZE=500
X_SYNTH_NATIVE_QUEUE_SIZE=8
X_SYNTH_MAX_STRUCTURE_ATOMS=1024
X_SYNTH_HEALTH_CACHE_SECONDS=10
X_SYNTH_HEALTH_TIMEOUT_SECONDS=2
X_SYNTH_REQUEST_BYTES=10485760
X_SYNTH_RESPONSE_BYTES=33554432

# Development only; production serves the built workbench on the product host.
VITE_X_SYNTH_API_TARGET=http://127.0.0.1:8769
